graph TD
    subgraph Entrada["Adaptadores de entrada (infrastructure/web · infrastructure/kafka)"]
        CC["ChequeraController"]
        RC["ReciboController"]
        MC["MercadoPagoController"]
        NC["CorreoController"]
        PC["PingController"]
        KL["ChequeraEventListener"]
        CL["CuotaEventListener"]
        NL["NotificacionEventListener"]
    end

    subgraph Procesos["procesos/* (application · ports)"]
        CS["ChequeraService"]
        RS["ReciboService"]
        ES["EnlacePagoService"]
        CUC["Casos de uso: generar PDF / enviar chequera / enviar cuota"]
        NS["Notificación: enviar correo / procesar evento"]
    end

    subgraph Salida["Puertos de salida + adaptadores"]
        PDF["ChequeraPdfGenerator → OpenPdfChequeraGenerator"]
        RPDF["ReciboPdfGenerator → OpenPdfReciboGenerator + QrAfipGenerator"]
        MAIL["gateways/correo → JavaMailCorreoEnviadorAdapter"]
        PUB["SolicitudChequera/CuotaPublisher → send-chequera · send-cuota"]
        RES["ResultadoNotificacionPublisher → notificacion-resultado"]
    end

    subgraph Datos["datos/* (fachadas + ports out + adapters Feign)"]
        DQ["chequera"]
        DF["facturacion"]
        DP["persona"]
        DC["catalogo"]
        DPP["preferenciaPago"]
        DV["validacionEmail"]
    end

    subgraph Shared["shared (kernel)"]
        MODEL["domain/model"]
        DTOS["infrastructure/dto + mapper"]
        SET["SenderSettings"]
    end

    CC --> CS
    CC --> PUB
    RC --> RS
    MC --> ES
    NC --> NS
    KL --> CS
    CL --> CUC
    NL --> NS
    CS --> CUC
    RS --> CUC
    ES --> CUC
    CUC --> PDF
    CUC --> RPDF
    CUC --> MAIL
    CUC --> DQ
    CUC --> DF
    CUC --> DP
    CUC --> DC
    CUC --> DPP
    CUC --> DV
    NS --> MAIL
    NS --> RES
    PUB --> KB[("Kafka Broker")]
    KB --> KL
    KB --> CL
    KB --> NL
    DQ --> CORE[("tesoreria-core-service")]
    DF --> CORE
    DP --> CORE
    DC --> CORE
    DPP --> CORE
    DPP --> MP[("tesoreria-mercadopago-service")]
    DV --> CORE
    MAIL --> SMTP[("SMTP")]
    PDF --> FS[("path.reports")]
    RPDF --> FS
    MODEL -.-> CUC
    MODEL -.-> NS
    DTOS -.-> DQ
    SET -.-> NS
